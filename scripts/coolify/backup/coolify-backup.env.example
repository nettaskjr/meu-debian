# /etc/coolify-backup.env - configuracao do backup-instancia.sh
#
# Instale com:
#   sudo install -m 600 coolify-backup.env.example /etc/coolify-backup.env
#   sudo editor /etc/coolify-backup.env

# Bucket e endpoint do Cloudflare R2 (o bucket precisa existir).
R2_BUCKET="coolify-backups"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# Prefixo dentro do bucket. Use o MESMO prefixo na regra de lifecycle do R2.
R2_PREFIX="instancia"

# Token R2 com permissao "Object Read & Write", com escopo no bucket de backup.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Passphrase usada para criptografar o pacote (AES-256).
# Gere com: openssl rand -base64 48 | sudo tee /etc/coolify-backup.passphrase
PASSPHRASE_FILE="/etc/coolify-backup.passphrase"

# Diretorio de trabalho local (precisa de espaco em disco para o pacote).
WORK_BASE="/var/backups/coolify"

# 1 = mantem o pacote local mesmo apos upload com sucesso (padrao: 0).
KEEP_LOCAL="0"
